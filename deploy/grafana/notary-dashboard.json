{
  "title": "Notary",
  "uid": "llcforge-notary",
  "tags": [
    "llcforge",
    "notary"
  ],
  "description": "RPKI Route Origin Validation checker with RTR client, watch daemon and query API",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Instance",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "query": {
          "query": "label_values(llcforge_alert_received_total{tool=\"notary\"}, instance)",
          "refId": "instance"
        },
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Notary on GitHub",
      "type": "link",
      "url": "https://github.com/LLCForge/Notary"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Process",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(up{job=\"notary\",instance=~\"$instance\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alert queue depth",
      "datasource": {
        "type": "prometheus",
